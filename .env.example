# 页面和 API 均需要本地测试账户令牌。值为客户编号到令牌的 JSON 映射。
# 示例形状：{"customer_a":"令牌A","customer_b":"不同的令牌B"}；不要直接使用示例令牌。
SUPPORT_ACCOUNT_TOKENS=
# auto：优先 DeepSeek，故障时切换智谱；只加入 API_KEY 和 MODEL 均完整的服务。
# 指定单服务时可用 LLM_PROVIDER=deepseek 或 zhipu，LLM_FALLBACKS=[] 禁用备用。
# 指定主服务和备用示例：LLM_PROVIDER=deepseek，LLM_FALLBACKS=["zhipu"]。
LLM_PROVIDER=auto
LLM_FALLBACKS=[]

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash-250414
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/


SUPPORT_DATA_DIR=data
# 模型输入的估算 Token 预算，包含提示、完整历史轮次、工具定义与工具结果。
SUPPORT_CONTEXT_TOKEN_BUDGET=12000
# 整次请求的模型尝试（含路由与重试）、工具尝试及墙钟耗时预算。
SUPPORT_REQUEST_MAX_MODEL_CALLS=24
SUPPORT_REQUEST_MAX_TOOL_CALLS=24
SUPPORT_REQUEST_TIMEOUT_SECONDS=120
# 可选：只替换业务库，记忆库仍由 SUPPORT_DATA_DIR 决定。
SUPPORT_AGENT_DB_URL=
# 可选：本地 Markdown 政策目录，默认项目 policies/。版本不可原地改写。
SUPPORT_POLICY_DIR=
# 只用于首次迁移无币种的旧浮点金额；请先核对旧数据。支持 CNY、USD。
SUPPORT_LEGACY_CURRENCY=CNY
