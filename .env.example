# demo 无需模型 API Key；页面和 API 仍需本地测试账户令牌。
# 页面和 API 均需要本地测试账户令牌。值为客户编号到令牌的 JSON 映射。
# 示例形状：{"customer_a":"令牌A","customer_b":"不同的令牌B"}；不要直接使用示例令牌。
SUPPORT_ACCOUNT_TOKENS=
# auto 保持兼容：有智谱 Key 时仅使用智谱，否则使用原 Gemini/Groq 池。
# 显式选择 zhipu、gemini 或 groq 时，不自动切换到其他服务商。
LLM_PROVIDER=auto
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 可选：多个合法可用密钥以逗号分隔；按服务方使用政策配置。
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SUPPORT_DATA_DIR=data
# 可选：只替换业务库，记忆库仍由 SUPPORT_DATA_DIR 决定。
SUPPORT_AGENT_DB_URL=
